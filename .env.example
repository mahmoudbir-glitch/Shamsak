# PostgreSQL / Supabase connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Required for inverter/webhook POSTs to /api/telemetry.
TELEMETRY_INGEST_TOKEN="replace-with-a-long-random-secret"

# Optional protection for persisted settings writes.
SETTINGS_API_TOKEN="replace-with-a-long-random-secret"
