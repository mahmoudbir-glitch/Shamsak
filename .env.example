# Canonical Prisma/PostgreSQL connection string.
# Keep this variable configured in Vercel Production + Preview.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Optional compatibility aliases used by some Vercel/Prisma integrations.
# If DATABASE_URL is absent, the application can fall back to these names.
# Do not copy these placeholders as real credentials.
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

TELEMETRY_INGEST_TOKEN="replace-with-a-long-random-secret"

# Shamsak login - server only, never use NEXT_PUBLIC_ here.
SHAMSAK_USER="trial-user"
SHAMSAK_PASSWORD="replace-with-trial-password"

# Optional separate owner account for the private monitoring dashboard.
# If these are configured, only this account can open /admin/monitor.
SHAMSAK_OWNER_USER="owner"
SHAMSAK_OWNER_PASSWORD="replace-with-owner-password"

# Optional legacy hashed password alternative:
# SHAMSAK_PASSWORD_HASH="scrypt:SALT:HASH"
AUTH_SECRET="replace-with-a-long-random-32-byte-secret"
INVERTER_CONFIG_SECRET="replace-with-a-long-random-32-byte-secret"
